# ==============================================================================
# GLOBAL PRODUCTION CONFIGURATION
# ==============================================================================
NODE_ENV=production
NEXT_PUBLIC_ENV=production
APP_ENVIRONMENT=production

# ==============================================================================
# SENTRY MONITORING SECRETS
# ==============================================================================
SENTRY_AUTH_TOKEN=sentry_auth_token_here
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxx@sentry.io/xxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxx@sentry.io/xxxxxx
SENTRY_ORG=suffat-ul-huffaz
SENTRY_PROJECT=internal-erp

# ==============================================================================
# UPSTASH REDIS SERVERLESS CREDENTIALS
# ==============================================================================
UPSTASH_REDIS_REST_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=upstash_rest_token_here

# ==============================================================================
# SERVICE BOUNDARY NETWORKING (RAILWAY INTERNAL MESH NETWORK)
# ==============================================================================
# Resolves over Railway's private DNS overlay, avoiding public internet latency
INTERNAL_API_URL=http://backend-api.railway.internal:8000
INTERNAL_SERVER_TOKEN=cryptographic_service_to_service_shared_secret

# ==============================================================================
# PUBLIC ENTRYPOINTS
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.suffat.org
ALLOWED_DOMAINS=suffat.org,portal.suffat.org

# Location: devsecops/sca-container/Dockerfile.distroless
# Stage 1: Build Dependencies and Compilers
FROM python:3.12.3-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install dependencies to a local folder
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Hardened Runtime (Distroless Container)
FROM gcr.io/distroless/python3-debian12:nonroot

WORKDIR /app

# Copy python dependencies from builder
COPY --from=builder /root/.local /home/nonroot/.local
COPY --from=builder /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
COPY --from=builder /lib/x86_64-linux-gnu /lib/x86_64-linux-gnu

# Expose local environment parameters
ENV PATH=/home/nonroot/.local/bin:$PATH
ENV PYTHONPATH=/home/nonroot/.local/lib/python3.12/site-packages

# Copy core execution codebase
COPY --chown=nonroot:nonroot app/ /app/app/

# Enforce non-root execution context (UID 10001)
USER 10001:10001

EXPOSE 8000

ENTRYPOINT ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
